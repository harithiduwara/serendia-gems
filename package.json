{
  "name": "serendia-gems",
  "version": "1.0.0",
  "private": true,
  "description": "SerendiaGems.com \u2014 Ceylon sapphire atelier. Enterprise storefront.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "verify": "npm run typecheck && npm run test && npm run build",
    "build:static": "node scripts/prepare-static.mjs && STATIC_EXPORT=1 next build",
    "smoke:static": "node scripts/smoke.mjs --static"
  },
  "dependencies": {
    "next": "15.5.25",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.5.25",
    "postcss": "^8.5.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.2"
  }
}
